# Copy to .env and paste your OpenRouter key. Then:
#   ollama serve && ollama pull embeddinggemma   # embeddings for memory
#   cargo run -- seed-user                        # load the dummy seed user
#   cargo run -- playground                       # open http://127.0.0.1:8088
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Provider for the CHAT model (embeddings always use Ollama embeddinggemma):
DITTOBENCH_PROVIDER=openrouter
# Chat model for LOCAL practice. Defaults to the on-chain scored model. Scoring
# locks inference to Qwen3-32B in a TEE (Chutes Qwen/Qwen3-32B-TEE) and overrides
# this value.
DITTOBENCH_MODEL=qwen/qwen3-32b
# For Chutes hosted OpenAI-compatible inference:
# DITTOBENCH_PROVIDER=chutes
# CHUTES_API_KEY=cpk_your-key-here
# CHUTES_BASE_URL=https://llm.chutes.ai/v1
# DITTOBENCH_MODEL=deepseek-ai/DeepSeek-V3.2-TEE
# To practice against the EXACT scored backend, set DITTOBENCH_MODEL=Qwen/Qwen3-32B-TEE
# here (same TEE model the validator's relay serves when scoring).
OLLAMA_BASE_URL=http://localhost:11434
DITTOBENCH_DB=./dittobench.db

# Playground "Submit" tab: hosted BYOK practice (see README "Hosted BYOK practice").
DITTOBENCH_API_URL=https://dittobench-api-22790208601.us-central1.run.app
# Public URL of your `serve` harness; the hosted validator must be able to
# reach it (e.g. `ngrok http 8080`):
DITTOBENCH_HARNESS_URL=http://localhost:8080
# "crate build" target: this crate's git location (on-chain / local Docker only):
DITTOBENCH_CRATE_GIT=https://github.com/ditto-assistant/dittobench-starter-kit
DITTOBENCH_CRATE_REF=main
